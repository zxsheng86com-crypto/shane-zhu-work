{
  "routes": [
    { "src": "^/work/common-ground$", "headers": { "Location": "/work/dji-romo" }, "status": 308 },
    { "src": "^/work/dji-fly$", "headers": { "Location": "/work/fly-fpv-2-0" }, "status": 308 },
    { "src": "^/work/dji-aura-logo$", "headers": { "Location": "/work/dji-aura" }, "status": 308 },
    {
      "src": "^/media/.*",
      "has": [{ "type": "header", "key": "sec-fetch-mode", "value": "navigate" }],
      "headers": { "Cache-Control": "private, no-store" },
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/media/.*",
      "has": [{ "type": "header", "key": "sec-fetch-site", "value": "cross-site|same-site|none" }],
      "headers": { "Cache-Control": "private, no-store" },
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/media/.*",
      "missing": [
        { "type": "header", "key": "sec-fetch-site", "value": "same-origin" },
        { "type": "header", "key": "referer", "value": "https://(www\\.)?shanezhu\\.work(/.*)?" }
      ],
      "headers": { "Cache-Control": "private, no-store" },
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/media/.*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Cross-Origin-Resource-Policy": "same-origin"
      },
      "continue": true
    },
    {
      "src": "^/_next/static/.*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    }
  ]
}
